// The root runner Worker: the runner code with root bindings, for `infra-root` plans and applies.
// No route, no custom domain, no workers.dev, no preview URLs: reachable only through the
// authorizer's service binding to the `RootRunner` entrypoint. Deployed only by the bootstrap path
// (never by the deployer), so the deployer can never change what holds root credentials.
// Values marked COMMISSIONING are filled from the seed log and Terraform outputs at commissioning.
{
  "name": "root-runner",
  "main": "worker/root-runner.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "limits": { "cpu_ms": 60000 },
  "vars": {
    "ACCOUNT_ID": "1a799c6e699d2ef7e87398692ce3ad7b",
    // COMMISSIONING: numeric id of the `deployer` GitHub App (the root runner reuses it).
    "GITHUB_APP_ID": "0",
    // COMMISSIONING: Cloudflare token id (not value) of the root R2 state token, from the seed log.
    "R2_STATE_ROOT_TOKEN_ID": "",
    "SECRETS_STORE_ID": "b6504fe2d5f64352954629bc7185fb79",
    // Restricts this runner to root.* jobs; the deployer omits it and runs only deployer jobs.
    "RUNNER_ROLE": "root"
  },
  "durable_objects": {
    "bindings": [{ "name": "RUNNER", "class_name": "RunnerJob" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RunnerJob"] }],
  "containers": [
    {
      "class_name": "RunnerJob",
      "scheduling_policy": "durable_object",
      "images": { "runner": { "dockerfile": "./container/Dockerfile", "build_context": "./container" } }
    }
  ],
  "r2_buckets": [
    { "binding": "RUNNER_LOGS", "bucket_name": "runner-logs" },
    // See docs/RUNNER.md "Open items": a bucket bound only to the root runner would keep the
    // deployer from deleting root plans and the infra-root stack lock.
    { "binding": "TF_PLANS", "bucket_name": "tf-plans-root" }
  ],
  "services": [{ "binding": "AUTHORIZER", "service": "authorizer", "entrypoint": "Authorizer" }],
  "secrets_store_secrets": [
    { "binding": "GITHUB_APP_KEY", "store_id": "b6504fe2d5f64352954629bc7185fb79", "secret_name": "DEPLOYER_GITHUB_APP_KEY" },
    { "binding": "CF_ROOT_PLAN", "store_id": "b6504fe2d5f64352954629bc7185fb79", "secret_name": "CF_ROOT_PLAN" },
    { "binding": "CF_ROOT_APPLY", "store_id": "b6504fe2d5f64352954629bc7185fb79", "secret_name": "CF_ROOT_APPLY" },
    { "binding": "R2_STATE_ROOT", "store_id": "b6504fe2d5f64352954629bc7185fb79", "secret_name": "R2_STATE_ROOT" },
    { "binding": "TF_ENCRYPTION_ROOT", "store_id": "b6504fe2d5f64352954629bc7185fb79", "secret_name": "TF_ENCRYPTION_ROOT" },
    { "binding": "CF_SECRETS_WRITE", "store_id": "b6504fe2d5f64352954629bc7185fb79", "secret_name": "CF_SECRETS_WRITE" }
  ]
}
