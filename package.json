{
  "name": "deployer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deployment control plane: coordinator, release ingest, adapters and the Terraform runner, all inside the Cloudflare boundary.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test --test-reporter=dot \"test/worker/**/*.test.ts\" \"test/runner/**/*.test.ts\" \"test/clients/**/*.test.ts\"",
    "typecheck": "wrangler types --include-runtime=true --strict-vars=false worker-configuration.d.ts >/dev/null && tsc --noEmit -p tsconfig.json",
    "check:config": "node scripts/check-config.mjs",
    "test:e2e": "node --test --test-reporter=spec test/e2e/push-to-main.test.ts"
  }
}
